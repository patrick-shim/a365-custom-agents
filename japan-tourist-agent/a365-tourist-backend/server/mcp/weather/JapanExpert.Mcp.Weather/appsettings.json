{
  "McpAuthorization": {
    "TenantId": "",
    "Audience": "",
    "RequiredScope": "Mcp.Invoke"
  },
  "Jma": {
    "ForecastEnabled": true,
    "ForecastBaseAddress": "https://www.jma.go.jp/bosai/forecast/data/forecast/",
    "AlertFeedAddress": "https://www.data.jma.go.jp/developer/xml/feed/extra.xml",
    "MaximumForecastAgeHours": 24,
    "MaximumForecastClockSkewHours": 3,
    "MaximumFeedEntries": 200,
    "MaximumResponseBytes": 4194304,
    "TimeoutSeconds": 20
  },
  "MetNorway": {
    "Enabled": true,
    "BaseAddress": "https://api.met.no/weatherapi/locationforecast/2.0/",
    "UserAgent": "JapanExpertMcp/1.0 (+https://github.com/patrick-shim/rg-a365-custom-agents)",
    "CoordinateDecimals": 4,
    "MaximumResponseBytes": 2097152,
    "TimeoutSeconds": 20
  },
  "Cache": {
    "ForecastTtlSeconds": 1800,
    "AlertTtlSeconds": 60,
    "CurrentTtlSeconds": 600,
    "SizeLimit": 256,
    "MaximumEntrySize": 64
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
