{
  "McpAuthorization": {
    "TenantId": "",
    "Audience": "",
    "RequiredScope": "Mcp.Invoke"
  },
  "Overpass": {
    "Endpoint": "https://overpass-api.de/api/interpreter",
    "UserAgent": "JapanExpertMcp/1.0 (+https://github.com/patrick-shim/rg-a365-custom-agents)",
    "QueryTimeoutSeconds": 25,
    "MaximumFetchElements": 120,
    "FetchMultiplier": 3,
    "MaximumResponseBytes": 2097152
  },
  "Cache": {
    "TtlSeconds": 86400,
    "SizeLimit": 512,
    "MaximumEntrySize": 64
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
