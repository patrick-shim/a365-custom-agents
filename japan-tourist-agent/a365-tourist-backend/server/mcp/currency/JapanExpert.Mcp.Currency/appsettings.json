{
  "McpAuthorization": {
    "TenantId": "",
    "Audience": "",
    "RequiredScope": "Mcp.Invoke"
  },
  "Frankfurter": {
    "Enabled": true,
    "BaseAddress": "https://api.frankfurter.dev/v2/",
    "Providers": "ECB",
    "TimeoutSeconds": 20,
    "MaximumResponseBytes": 1048576
  },
  "EcbSdmx": {
    "Enabled": true,
    "BaseAddress": "https://data-api.ecb.europa.eu/service/data/EXR/",
    "HistoricalLookbackDays": 7,
    "TimeoutSeconds": 20,
    "MaximumResponseBytes": 1048576
  },
  "Cache": {
    "TtlSeconds": 21600,
    "SizeLimit": 256,
    "MaximumEntrySize": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
