          }
        },
        "agentic-mcp": {
          "Type": "AgenticUserAuthorization",
          "Settings": {
            "Scopes": [],
            "AlternateBlueprintConnectionName": "ServiceConnection"
          }
        },
        "obo-user": {
          "Type": "AzureBotUserAuthorization",
          "Settings": {
            "AzureBotOAuthConnectionName": "korea-tourist-assistant-obo"
